# EvacuateSim backend configuration example.
# Copy to backend/.env to override. All values have safe defaults.

# SQLite location (a file under backend/data/ is created automatically)
EVACUATESIM_DATABASE_URL=sqlite:///D:/projects/evacuate/backend/data/evacuatesim.db

# CORS origins allowed in development (Vite dev server)
EVACUATESIM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Hard computation limits
EVACUATESIM_MAX_GRID_WIDTH=120
EVACUATESIM_MAX_GRID_HEIGHT=120
EVACUATESIM_MAX_OCCUPANTS=2000
EVACUATESIM_MAX_SIM_DURATION_S=3600
EVACUATESIM_MAX_EXPERIMENT_RUNS=200

# Engine defaults
EVACUATESIM_DEFAULT_DT_S=0.25
EVACUATESIM_DEFAULT_CELL_SIZE_M=0.5
EVACUATESIM_DEFAULT_FRAME_INTERVAL_S=1.0

# Run execution
EVACUATESIM_RUN_WORKERS=2
EVACUATESIM_MAX_FRAMES_PER_RUN=4000
